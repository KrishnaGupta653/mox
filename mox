#!/bin/bash
# mox - Terminal Music CLI wrapper script
# This script provides a convenient way to run mox from the root directory

# Add Homebrew to PATH (needed for socat, jq, etc on macOS). Plain PATH edits instead of
# `eval "$(brew shellenv)"`, which forks brew and added ~50ms to every mox command.
if [[ "$OSTYPE" == "darwin"* ]]; then
  for _brew_bin in /usr/local/bin /opt/homebrew/bin; do
    [[ -d "$_brew_bin" && ":$PATH:" != *":$_brew_bin:"* ]] && PATH="$_brew_bin:$PATH"
  done
  export PATH
fi

# Handle symlinks properly - resolve to actual script location
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Set environment variable so mox.sh knows where the package is installed
export MOX_PACKAGE_DIR="$SCRIPT_DIR"

exec "$SCRIPT_DIR/src/mox.sh" "$@"