# Development files
.git/
.gitignore
*.md
!README.md

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Runtime files
*.pid
*.sock

# Test files
test/
tests/
spec/

# Documentation (except README)
docs/
doc/

# Homebrew formula (not needed in npm package)
*.rb

# Build artifacts
dist/
build/

# Python cache
__pycache__/
*/__pycache__/
*.pyc

# Backup files (never publish)
*.bak
mox.sh.bak

# lib/ Python template rule — must allow src/lib/ shell modules
lib/
!src/lib/